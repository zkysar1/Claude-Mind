#!/usr/bin/env bash
# Layer B pre-commit gates — daemon-only drift defense.
#
# Tracked and version-controlled so it propagates to every clone via
# `git config core.hooksPath core/githooks` (installed idempotently by
# core/scripts/install-git-hooks.sh, invoked from sessionstart-orchestrator.sh
# Step 0.5).
#
# See .claude/rules/no-python-cli-fallback.md (CLI-fallback gate) and
# zeta/reports/g-115-802-design.md (endpoint-registry gate).
set -e
REPO="$(git rev-parse --show-toplevel)"

# Telemetry (g-115-2404 earn-the-keep review, 2026-07-16): BLOCK-ONLY logging.
# A gate that refuses a commit logs one `block` firing to meta/gate-firings.jsonl
# via gate-log.sh; clean passes log NOTHING. Rationale: on own-cloud boxes one
# gate-firings append is a whole-object S3 read-modify-write (measured 4.7-10s
# at 38MB / 117k records) — per-gate pass/noop logging would multiply hook
# latency ~6-12x on every commit. The exposure denominator for these gates is
# the git commit count (landed commits all passed; blocked attempts are each
# logged), so fire-rate stays measurable at zero happy-path cost. Retirement
# criterion (guard-769): a gate with 0 block firings across a review window of
# N-thousand commits AND whose regression class is no longer plausible is a
# retire candidate at the next earn-the-keep review; insurance-class gates
# (secrets, constitutional anchor) are exempt from count-based retirement.
# Telemetry is fail-open: gate-log failure never changes the gate verdict.
_gate() {
  local id="$1"; shift
  local rc=0
  "$@" || rc=$?          # `|| rc=$?` captures the real gate status under set -e
  [ "$rc" -eq 0 ] && return 0
  bash "$REPO/core/scripts/gate-log.sh" "$id" block \
    --caller "core/githooks/pre-commit" \
    --trigger "gate-exit=$rc" 2>/dev/null || true
  exit "$rc"
}

# Gate 1: Python CLI fallback regression (existing).
_gate check-no-python-cli-fallback bash "$REPO/core/scripts/check-no-python-cli-fallback.sh"

# Gate 1b: Daemon-wrapper reparse regression (g-115-740 sister gate,
# 2026-05-18). Catches the SUBTLER shape — wrapper calls rt_call AND
# also opens daemon data files directly to second-guess responses.
# Sister to Gate 1; that gate catches `_fallback_exec` /
# `python3 -m core.scripts.X`, this one catches `rt_call` + inline
# `py -3 -c` block reading `Path(WORLD_PATH|META_PATH|AGENT_DIR)/*.jsonl`.
_gate check-no-daemon-wrapper-reparse bash "$REPO/core/scripts/check-no-daemon-wrapper-reparse.sh"

# Gate 2: Daemon endpoint registry vs filesystem (g-115-802).
case "$(uname -s 2>/dev/null || echo unknown)" in
    MINGW*|MSYS*|CYGWIN*) PY="py -3" ;;
    *) PY="python3" ;;
esac
_gate check-mind-api-endpoint-registry $PY "$REPO/core/scripts/check-mind-api-endpoint-registry.py"

# Gate 3: Phase-5 meta -> world import invariant (sec15; see
# mind_api/src/INTERFACE.md). Refuses commits where mind_api/src/meta/**
# imports mind_api.src.world or any world-domain endpoint module.
_gate meta-imports-world-gate $PY "$REPO/core/scripts/meta-imports-world-gate.py"

# Gate 4: Phase-6 Layer-1 -> Layer-2 import invariant (sec15; see
# core/BOUNDARY.md). Refuses commits where a Layer-1 file imports/sources
# mind_api.src (daemon-launcher `python -m mind_api.src` is whitelisted).
_gate layer1-no-runtime-imports-gate $PY "$REPO/core/scripts/layer1-no-runtime-imports-gate.py"

# Gate 5: settings.json deny-baseline net (constitutional anchor, 2026-05-16).
# Independent second net behind the PreToolUse settings-structural-validator;
# reuses its _validate() (single source of truth for PROTECTED_DENY). No-op
# unless .claude/settings.json is staged. See CLAUDE.md "two-file settings
# rule", core/config/conventions/constitutional-rings.md Ring 0, rb-931.
_gate check-settings-deny-baseline $PY "$REPO/core/scripts/check-settings-deny-baseline.py"

# Gate 6: Domain-leak surveillance (ADVISORY, 2026-05-18 packaging plan
# Phase 4.4). Runs core/scripts/domain-leak-check.sh on every commit to
# surface domain terms leaking into core/scripts/, core/config/, or
# .claude/rules/. Gate is advisory — exit code from the leak check is
# NOT propagated, so existing leaks don't block commits. The signal
# surfaces on stderr so authors notice when they introduce new leaks;
# /verify-learning Section DLK (planned) elevates persistent leaks to
# Investigate goals on the regular learning-gate cadence. Switch to
# blocking by removing the `|| true` once existing leaks are fixed
# (packaging plan Phase 6).
#
# STAGED-SCOPED (g-001-314, 2026-07-03): domain-leak-check.sh --staged scans
# ONLY this commit's staged files (git diff --cached), not the whole repo — ~4s
# vs the >2min full-tree scan that g-001-312 had to time-cap at 30s (the dormant
# hook, enabled in g-001-312, made every commit exceed the loop's 2min
# iteration-commit Bash-timeout). Staged scope is both faster AND more correct:
# it flags domain terms YOU introduce in this commit, not pre-existing leaks
# elsewhere (the full-tree /verify-learning + manual/CI audits still cover
# those). Advisory: `|| true` keeps it non-blocking — the signal surfaces on
# stderr, never fails the commit.
bash "$REPO/core/scripts/domain-leak-check.sh" --staged >&2 || true

# Gate 7: Phase 2.6 bare-agent-prefix regression (2026-05-19). After
# Phase 2.5.D, `<agent>/X/` references in SKILL.md/rule/convention
# markdown without the `agents/` parent silently produce wrong paths
# when the LLM substitutes the placeholder (the 2026-05-19 bravo/
# cruft incident shape). Refuses commits introducing the regression
# in staged .md files. See .claude/rules/path-resolution.md.
_gate check-no-bare-agent-prefix bash "$REPO/core/scripts/check-no-bare-agent-prefix.sh"

# Gate 8: Secret-content scanner (2026-05-21). Refuses commits whose
# staged content contains GitHub PAT / OAuth-token / AWS-access-key
# shapes. Origin: the rotate-lambda-common-pat.sh incident where an
# auto-bundled file carried a 33-char identifier-truncation of a
# fine-grained PAT into a commit because L1 path-resolution-hook
# (Write/Edit/MultiEdit only) and iteration-commit.sh's filename
# filter both missed it. See script header for full pattern set +
# bypass mechanisms.
_gate check-no-hardcoded-secrets bash "$REPO/core/scripts/check-no-hardcoded-secrets.sh"

# Gate 9: session-manifest sync_tier completeness (2026-06-03). Fail-closed
# gate from the session-continuity redesign (#45). core/config/session-
# manifest.yaml is the SSOT for own-cloud session-file sync disposition —
# owncloud_sync.py derives the machine-local denylist + continuity pull-set
# from each entry's `sync_tier`. A missing/invalid sync_tier makes the loader
# fail closed (whole session/ tree treated machine-local), so a continuity
# file would silently STOP syncing to S3 (knowledge loss on agent-move) — a
# direct multi-machine hazard. Gated on the manifest being staged (the gate's
# documented design intent + Gate 5's no-op-unless-staged precedent): the
# validation is only meaningful when the manifest changes. Built 2026-06-02
# but left unwired; wired here as one of the 7 orphan-script resolutions
# (2026-06-03). Self-contained bash; needs no MIND_AGENT.
if git diff --cached --name-only | grep -q '^core/config/session-manifest\.yaml$'; then
    _gate session-manifest-gate bash "$REPO/core/scripts/session-manifest-gate.sh"
fi

# Gate 10: skill-edit earn-the-keep chokepoint (g-115-1467, earn-the-keep
# Phase 1 / G3, 2026-06-14). A SKILL.md EDIT must not REGRESS structural
# completeness (HEAD vs working tree) — front matter, Return Protocol section,
# body substance, heading structure, procedure — scored through
# eval_harness.gate(no_regression), the validation substrate the keystone
# self-check validated (G3). Blocks the 2026-05-11 front-matter-loss incident
# shape (.claude/rules/domain-free-examples.md) at commit time. Self-gates
# (no-op when no SKILL.md is staged); the conditional avoids spawning Python
# otherwise (Gate 5/9 no-op-unless-staged precedent). Bypass:
# SKILL_EDIT_GATE_OVERRIDE="<justification>". See
# core/scripts/skill-edit-precommit-gate.py.
if git diff --cached --name-only | grep -qE '^\.claude/skills/[^/]+/SKILL\.md$'; then
    _gate skill-edit-precommit-gate $PY "$REPO/core/scripts/skill-edit-precommit-gate.py"
fi

# Gate 11: OWNERSHIP_MODE / MACHINE_OWNED_AGENTS re-introduction (g-115-1737,
# 2026-07-02). The OWNERSHIP_MODE cutover flag, the static MACHINE_OWNED_AGENTS
# env list, and the runner-token sync-ownership fallback were removed —
# single-runner ownership is now unconditional, keyed on STORAGE_BACKEND alone
# (own-cloud => live DDB runner-claim resolution; any other backend => own-all).
# Refuses commits that re-introduce a READ of either removed env var (env-read
# pattern, NOT a bare mention — prose/comments legitimately name them). Scans
# only STAGED added lines, so it is cheap and never blocks unrelated commits.
# Sister to Gate 1. See .claude/rules/... + mind_api/docs/lodestar-dynamic-
# ownership-design.md (SUPERSEDED note). Bypass is NOT the answer — fix the code.
_gate check-no-ownership-flag bash "$REPO/core/scripts/check-no-ownership-flag.sh"

# Gate 12: bare-"bash" argv[0] in Python subprocess calls (g-115-3171,
# 2026-07-26). guard-580 forbids subprocess.run(["bash", ...]) — on win32
# CreateProcess searches System32 BEFORE PATH, so a bare argv[0] reaches the
# WSL launcher and BLOCKS FOREVER on a dead LxssManager (0-CPU child, parent
# hung in communicate(), pytest's faulthandler bound aborting the whole run).
#
# Layer A (the guardrail) was measured insufficient: rb-5255 records the author
# reintroducing the pattern within the HOUR of sweeping it out of 12 sites and
# rescoping the guardrail — correctly-scoped rule + freshly read + actively
# fixing that class = still reintroduced. Hence Layer B.
#
# STAGED-ADDED-LINES scoped (Gate 1's precedent): 19 pre-existing sites live in
# core/scripts/tests/*.py, so whole-tree blocking would refuse every unrelated
# commit. This refuses NEW introductions only; `--audit` reports the backlog
# (tracked by its own goal). Detection is AST-based, not grep, so `#`-comment
# and docstring prose mentions are structurally excluded rather than
# heuristically stripped — see the .py module docstring for why grep cannot.
# Escape for a genuinely POSIX-only path: `# allow-bare-bash: <reason>`.
# Companion authoring-time layer: bare-bash-authoring-gate.sh (PreToolUse[Bash])
# covers the ad-hoc `py -3 -c` surface this gate structurally cannot reach.
_gate check-no-bare-bash $PY "$REPO/core/scripts/check-no-bare-bash.py"

# Gate 13: exec bit on staged core/scripts *.sh (g-115-6640, 2026-08-18).
# A *.sh committed at mode 100644 is NOT executable on a Linux checkout, so
# every DIRECT-EXEC chain through it (`exec "$DIR/foo.sh"`, `./foo.sh`) dies
# with 'Permission denied' — while `bash foo.sh` callers keep working, which is
# why g-115-1901 hid until an exec-chain hit it on echo's boot.
#
# check-sh-exec-bits.sh already existed for this and had NO CALLER — its only
# registration was a line in core/config/verification-checklist.md, the 2000+
# item catalog that verify-learning's own Step 3 declares "too large to load in
# one context window". It was cited but unreachable, so the normalization it
# guards could regress silently. (Same shape as the routing-is-not-reachability
# finding: naming a recipient is not delivering to one.)
#
# --staged checks the INDEX mode, not the filesystem, and that difference is
# the reason this gate can work at all: on a clone with core.filemode=false —
# git's default on Windows, and this repo was authored there — a `chmod +x`
# never reaches the index, so a filesystem check passes on the very box that
# introduces the defect. Scoped to staged files (Gate 1/7/12 precedent), so it
# refuses NEW introductions and never blocks an unrelated commit. Verified
# against five cases: 100644 add REFUSED, 100755 add allowed, nothing-staged
# allowed, staged DELETION allowed (no mode to gate), and a rename INTO
# core/scripts at 100644 REFUSED.
_gate check-sh-exec-bits bash "$REPO/core/scripts/check-sh-exec-bits.sh" --staged

# Gate 14: no INVENTED top-level entry (2026-08-30, coach@zc-03). A staged
# addition whose first path component is not a top-level entry at HEAD is
# refused with the routing (domain code -> <world>/scripts, scratch ->
# agents/<agent>/temp, framework -> core/.claude). The L1 hook covers
# world/meta/agent-dir invention for Write/Edit only; PROJECT_ROOT is not a
# governed root and Bash mkdir/touch/cp bypass it — measured: 8 new root
# entries on one deployment, 6 cruft, and a domain package duplicated at the
# root that then diverged from the world copy for a day. The commit is the
# chokepoint Bash cannot skip. Override for a genuine framework extension:
# REPO_ROOT_ENTRY_OVERRIDE="<why>" (logged as an override firing).
_gate check-repo-root-entries $PY "$REPO/core/scripts/check-repo-root-entries.py" "$REPO"
