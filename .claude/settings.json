{
  "permissions": {
    "allow": [
      "Bash(mkdir -p .claude/skills/*)",
      "Write(**/.claude/skills/**)",
	  "Monitor(*)",
      "Edit(**/.claude/skills/**)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",
      "Bash(git clean*)",
      "AskUserQuestion(*)",
      "Read(*/.env.local)",
      "Edit(*/.claude/skills/start/*)",
      "Write(*/.claude/skills/start/*)",
      "Edit(*/.claude/skills/stop/*)",
      "Write(*/.claude/skills/stop/*)",
      "Edit(*/.claude/skills/boot/*)",
      "Write(*/.claude/skills/boot/*)",
      "Edit(*/world/knowledge/tree/_tree.yaml)",
      "Write(*/world/knowledge/tree/_tree.yaml)",
      "Edit(*/world/*.jsonl)",
      "Write(*/world/*.jsonl)",
      "Edit(*/meta/*.jsonl)",
      "Write(*/meta/*.jsonl)",
      "Write(*/session/agent-state)",
      "Edit(*/session/agent-state)",
      "Write(*/session/persona-active)",
      "Edit(*/session/persona-active)",
      "Write(*/session/stop-loop)",
      "Edit(*/session/stop-loop)",
      "Write(*/session/stop-block-count)",
      "Edit(*/session/stop-block-count)",
      "Write(*.active-agent-*)",
      "Edit(*.active-agent-*)",
      "Write(~/AppData/Local/Temp/claude/**)",
      "Edit(~/AppData/Local/Temp/claude/**)",
      "Write(//tmp/claude/**)",
      "Edit(//tmp/claude/**)"
    ]
  },
  "env": {
    "TZ": "UTC",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_AUTOUPDATER": "1",
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8",
    "GATE_D_ENABLED": "",
    "GATE_D_WORLD": "ayoai",
    "GATE_D_CORPUS_PATH": "<PROJECT_ROOT>\\core\\config\\gate-d-corpus-zds-2026-06-10.jsonl",
    "GATE_FIRINGS_SEGMENTED": "1",
    "OWNCLOUD_GZIP_STORES": "ayoai-mind",
    "UTILIZATION_COUNTERS_SPOOLED": "1"
  },
  "skillListingBudgetFraction": 0.05,
  "hooks": {
    "PreToolUse": [
