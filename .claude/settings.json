            "command": "bash $CLAUDE_PROJECT_DIR/core/scripts/precompact-serialize.sh",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/core/scripts/precompact-checkpoint.sh",
