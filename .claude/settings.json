{
  "permissions": {
    "allow": [
      "Bash(mkdir -p .claude/skills/*)",
      "Write(**/.claude/skills/**)",
	  "Monitor(*)",
      "Edit(**/.claude/skills/**)",
      "MultiEdit(**/.claude/skills/**)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",
      "Bash(git clean*)",
      "AskUserQuestion(*)",
      "Read(*/.env.local)",
      "Edit(*/.claude/skills/start/*)",
      "Write(*/.claude/skills/start/*)",
      "MultiEdit(*/.claude/skills/start/*)",
      "Edit(*/.claude/skills/stop/*)",
      "Write(*/.claude/skills/stop/*)",
      "MultiEdit(*/.claude/skills/stop/*)",
      "Edit(*/.claude/skills/boot/*)",
      "Write(*/.claude/skills/boot/*)",
      "MultiEdit(*/.claude/skills/boot/*)",
      "Edit(*/world/knowledge/tree/_tree.yaml)",
      "Write(*/world/knowledge/tree/_tree.yaml)",
      "MultiEdit(*/world/knowledge/tree/_tree.yaml)",
      "Edit(*/world/*.jsonl)",
      "Write(*/world/*.jsonl)",
      "MultiEdit(*/world/*.jsonl)",
      "Edit(*/meta/*.jsonl)",
      "Write(*/meta/*.jsonl)",
      "MultiEdit(*/meta/*.jsonl)",
      "Write(*/session/agent-state)",
      "Edit(*/session/agent-state)",
      "MultiEdit(*/session/agent-state)",
      "Write(*/session/persona-active)",
      "Edit(*/session/persona-active)",
      "MultiEdit(*/session/persona-active)",
      "Write(*/session/stop-loop)",
      "Edit(*/session/stop-loop)",
      "MultiEdit(*/session/stop-loop)",
      "Write(*/session/stop-block-count)",
      "Edit(*/session/stop-block-count)",
      "MultiEdit(*/session/stop-block-count)",
      "Write(*.active-agent-*)",
      "Edit(*.active-agent-*)",
      "MultiEdit(*.active-agent-*)"
    ]
  },
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "skillListingBudgetFraction": 0.05,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/context-reads-gate.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/context-reads-skill-gate.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash core/scripts/utilization-gate.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/bash-agent-inject.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "ScheduleWakeup",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/schedule-wakeup-gate.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/path-resolution-hook.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/session-manifest-write-gate-hook.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash core/scripts/rule-vs-convention-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/marker-placement-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/post-recovery-edit-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/evolution-prepare.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash core/scripts/settings-structural-validator.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/path-resolution-hook.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/session-manifest-write-gate-hook.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash core/scripts/rule-vs-convention-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/marker-placement-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/post-recovery-edit-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/evolution-prepare.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash core/scripts/settings-structural-validator.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/path-resolution-hook.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/session-manifest-write-gate-hook.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash core/scripts/rule-vs-convention-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/marker-placement-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/post-recovery-edit-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/evolution-prepare.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash core/scripts/settings-structural-validator.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/context-reads-record.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/context-reads-invalidate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash core/scripts/tree-sync-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash core/scripts/skill-stdin-json-lint.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash core/scripts/lock-symmetry-lint.sh --quiet --force",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/evolution-record.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/context-reads-invalidate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash core/scripts/tree-sync-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash core/scripts/skill-stdin-json-lint.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash core/scripts/lock-symmetry-lint.sh --quiet --force",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/evolution-record.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/context-reads-invalidate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash core/scripts/tree-sync-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash core/scripts/skill-stdin-json-lint.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash core/scripts/lock-symmetry-lint.sh --quiet --force",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash core/scripts/evolution-record.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/iteration-close-reminder.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/presence-tick.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/precompact-serialize.sh",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "bash core/scripts/precompact-checkpoint.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/sessionstart-orchestrator.sh",
            "timeout": 95
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/user-prompt-skill-record.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/stop-hook.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash core/scripts/stop-failure-hook.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
